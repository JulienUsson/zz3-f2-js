---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = {
  title: string;
  correctionUrl?: string;
  correctionDate?: Date;
};

const { title, correctionUrl, correctionDate } = Astro.props;
---

<html lang="fr">
  <head>
    <BaseHead title={title} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .prose {
        width: 1200px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
        text-align: justify;
      }
      .title {
        text-align: center;
      }
      .correction {
        margin: 0 0 1.5em;
        text-align: center;
      }
      .correction a {
        font-weight: 700;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="practice">
          <div class="title">
            <h1>{title}</h1>
            <hr />
          </div>
          {
            correctionUrl && (
              <p
                class="correction"
                data-display-date={correctionDate?.toISOString()}
                hidden
              >
                <a href={correctionUrl}>📘 Voir la correction</a>
              </p>
            )
          }
          <slot />
        </div>
      </article>
    </main>
    <Footer />

    <script>
      // Rend exécutables les blocs marqués `{monaco-run}` dans les exercices.
      import "../scripts/runnable";

      // Le lien vers le corrigé n'apparaît qu'à partir de sa date. Il part
      // masqué : sans ça, il clignote au chargement sur les pages où la date
      // n'est pas atteinte.
      document
        .querySelectorAll<HTMLElement>(".correction[data-display-date]")
        .forEach((lien) => {
          const date = new Date(lien.dataset.displayDate!);
          lien.hidden = new Date() < date;
        });
    </script>
  </body>
</html>
