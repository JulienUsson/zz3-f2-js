---
import QRCode from "qrcode";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE, SITE_TITLE } from "../consts";

// Le QR code est généré à la construction : la page reste un fichier statique,
// sans appel réseau ni service tiers au moment de l'affichage.
const qr = await QRCode.toString(SITE.url, {
  type: "svg",
  errorCorrectionLevel: "M",
  margin: 1,
  color: { dark: "#1c1917", light: "#ffffff" },
});

// `https://javascript.usson.dev` ➡️ `javascript.usson.dev`
const domain = SITE.url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead
      title={`Partager — ${SITE_TITLE}`}
      description={`Le lien et le QR code vers ${domain}`}
    />
    <style>
      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem 1rem 3rem;
        text-align: center;
      }
      .url {
        font-size: clamp(1.6rem, 6vw, 3.2rem);
        font-weight: 700;
        line-height: 1.1;
        word-break: break-all;
        color: inherit;
        text-decoration: none;
        border-bottom: 6px solid var(--accent);
      }
      .qr {
        width: min(340px, 70vw);
        aspect-ratio: 1;
        padding: 12px;
        background: #fff;
        border: 4px solid #1c1917;
        border-radius: 12px;
      }
      /* Le SVG produit par `qrcode` porte ses propres dimensions. */
      .qr :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
      }
      .hint {
        margin: 0;
        max-width: 32rem;
        color: rgb(var(--gray));
      }
      .home {
        font-size: 1.1rem;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <a class="url" href={SITE.url}>{domain}</a>

      <div class="qr" set:html={qr}></div>

      <p class="hint">
        Slides, exercices et corrections de la séance. Scannez le code, ou tapez
        l'adresse — c'est la même chose.
      </p>

      <a class="home" href="/">← Retour à l'accueil</a>
    </main>
    <Footer />
  </body>
</html>
